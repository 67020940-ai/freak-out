# 1. Google Gemini AI API Key (Get free key from https://aistudio.google.com/app/apikey)
# เมื่อใส่คีย์นี้ น้องนูเบ้ AI Agent และระบบวิเคราะห์ภาระสมองจะยิงหา Gemini 2.5 Flash ตัวจริง
GEMINI_API_KEY=""
VITE_GEMINI_API_KEY=""

# 2. Firebase Web Configuration (Get from Firebase Console > Project Settings > General > Your apps)
# เมื่อใส่คีย์เหล่านี้ ระบบจะเข้าสู่ระบบด้วย Google Account จริง และซิงค์ Firestore ข้ามเครื่อง
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# 3. Google OAuth Client ID for Web / Calendar API
# (สร้างจาก Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs)
VITE_GOOGLE_CLIENT_ID=""
